# JosHomes environment example.
# Copy to .env.local for local development. NEVER commit real secrets.
#
# With NONE of these set, the app runs fully on the deterministic fictional
# in-repo data and in-memory development accounts (password: joshomes-dev).
# Set the Supabase block to switch both the data and auth backends to a real
# Supabase project — no code changes required.

# --- Public app config ---
NEXT_PUBLIC_SITE_NAME=JosHomes
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search-engine indexing is OFF unless this is 'true'. Set it only for the real
# public pilot; staging/prototype deploys must stay noindex.
# JOSHOMES_ALLOW_INDEXING=false

# --- Session signing (required in production) ---
# Signs the stateless session cookie (HMAC-SHA256). MUST be set to a strong
# random value of at least 16 characters in production; a fixed development
# fallback is used only when NODE_ENV is not production.
# SESSION_SECRET=

# --- Supabase (Milestone 1+) ---
# When both public values are set, Supabase becomes the data + auth backend.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-only, never expose to the browser or prefix with NEXT_PUBLIC_

# --- Development auth escape hatch ---
# The in-memory mock auth provider is used automatically when NODE_ENV is not
# production and Supabase is unset. Set this to 'true' to also allow it in a
# non-public production-mode demo. Never set it on a real public deployment.
# JOSHOMES_ALLOW_DEV_AUTH=false

# --- Product configuration defaults (Milestone 4+; kept in DB platform_settings at runtime) ---
# FRESHNESS_FRESH_HOURS=72
# FRESHNESS_RECENT_DAYS=7
# FRESHNESS_OVERDUE_DAYS=7
# SEARCH_SUPPRESS_DAYS=14
# QUALIFIED_VIEW_DEDUPE_HOURS=24
# QUALIFIED_VIEW_MIN_ENGAGEMENT_SECONDS=5
